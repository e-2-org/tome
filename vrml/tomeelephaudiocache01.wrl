#VRML V2.0 utf8
Group {
	children [
		Sound {
			source DEF sound1 AudioClip {
				loop 					FALSE
				startTime			 1
				url	[	"../audio/rain8b.wav" ]
			}
			intensity     0        
			location      0 0 0  
			maxBack       1    
			maxFront      1   
			minBack       3   
			minFront      3 
			priority      0 
			spatialize    FALSE
		}
		DEF sound3 Sound {
			source DEF sound3Sound AudioClip {
				loop           FALSE
				pitch          1
				startTime			 1
				url	[	"../audio/thund8b.wav" ]
			}
			intensity     0   
			location      0 0 0 
			maxBack       1    
			maxFront      1  
			minBack       1   
			minFront      1 
			priority      0
			spatialize    FALSE 
		}
		
	]
}

