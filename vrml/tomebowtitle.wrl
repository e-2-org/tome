#VRML V2.0 utf8
Collision{ 
	collide FALSE
	children [
		Transform {
			rotation 0 1 0 1.57
			translation -1.3 3.1 0
			children [
				Shape {
					appearance Appearance {texture ImageTexture {url "../image/rm9bowtitle01.gif"}}
					geometry IndexedFaceSet { 
						coord Coordinate {point [-0.64 .2675 0,-0.64 -.2675 0,0.64 -.2675 0,0.64 .2675 0,]}
						coordIndex [0, 1, 2, 3, -1]
						texCoord TextureCoordinate {point [	0 1, 0 0, 1 0, 1 1]}
						texCoordIndex [0, 1, 2, 3, -1]
					}
				}
			]
		}
	]
}


