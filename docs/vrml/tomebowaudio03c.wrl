#VRML V2.0 utf8

#DEF avatar1 NavigationInfo { 
#	avatarSize      [0.1, 3.1, 0.05]
#	headlight       FALSE
#	type						"ANY"
#	visibilityLimit 700
#}
Group {
	children [
		#	Transform {
		#	translation -6 0 -10
		#	children [
		#	Shape {
		#	geometry Sphere {}
		#	}
		#	]
		#	}
		DEF view Viewpoint {
			position 100 100 -100
			orientation 0 1 0.4 2.2
			jump TRUE
		}
		DEF roomView Viewpoint {
			orientation -0.4903 0.855121 0.168448 0.64978
			position -2.2014 3.1 1.16235
		}
		DEF textSwitch Switch {
			whichChoice 0
			choice [
				Transform {
					translation 90 90 -96
					#translation 90 88 -97
					rotation 0 1 0.4 2.2
					children[
						Transform {
							children[
								Shape {
									geometry Text {
										fontStyle FontStyle {
											style "Bold"
											size 1.75
										}
										string ["      Tome :"]
										maxExtent 0
										length 0
									}
								}
							]
						}
						Transform {
							translation 0 -1 0
							children[
								Shape {
									appearance Appearance {
										material DEF loadText Material {}
									}
									geometry Text {
										string ["loading, please wait"]
										maxExtent 0
										length 0
									}
								}
							]
						}
					]
				}
			]
		}
		DEF roomProx ProximitySensor {
			center	-5 2.5 -3.1
			size		6.5 8 9.4
		}
		Sound {
			source DEF sound1 AudioClip {
				loop FALSE
				pitch          0.75
				stopTime      1
				url	[	"../audio/car8hz.wav" ]
			}
			direction 		0 0 1
			intensity     0.5        
			location      -6 0 -8  
			maxBack       5    
			maxFront      11   
			minBack       1   
			minFront      2 
			priority      0 
			spatialize    FALSE
		}
		Sound {
			source DEF sound2 AudioClip {
				loop FALSE
				stopTime      1
				url	[	"../audio/car8hz.wav" ]
			}
			direction 		0 0 1
			intensity     0.5
			location      -6 0 -8
			maxBack       5  
			maxFront      11 
			minBack       1   
			minFront      2 
			priority      0
			spatialize    FALSE 
		}
		DEF sound3 Sound {
			source DEF sound3Sound AudioClip {
				loop           TRUE
				pitch          1
				stopTime      1
				url	[	"../audio/siren8hz.wav" ]
			}
			direction 		0 0 1
			intensity     0   
			location      -6 0 -8 
			maxBack       5    
			maxFront      11  
			minBack       1   
			minFront      2 
			priority      0
			spatialize    FALSE 
		}
		DEF sound1Timer TimeSensor {
			cycleInterval	3.2
			loop	TRUE
			stopTime 1
		}
		DEF sound2Timer TimeSensor {
			cycleInterval	5.3
			loop	TRUE
			stopTime 1
		}
		DEF sound3Timer TimeSensor {
			cycleInterval	25
			loop	TRUE
			stopTime 1
		}
		DEF sound3IntensityTimer TimeSensor {
			cycleInterval 12
		}
		DEF sound3Intensity ScalarInterpolator {
			key [ 0, 0.15, 1 ]
			keyValue [ 0, 0.3, 0 ]
		}
	]
}
DEF introTimer TimeSensor {
	cycleInterval 20
	loop FALSE
}
DEF introMove PositionInterpolator {
	key [0, 0.5, 0.85, 1]
	keyValue [100 100 -100, -4 8.5 -50, -4.25 4.2 -8, -2.2014 4 1.16235]
}
DEF introOri OrientationInterpolator {
	key [0, 0.80, 1]
	keyValue [ 0 1 0.4 2.2, 0 1 0 3.25, -0.4903 0.855121 0.168448 0.64978 ]
}
DEF textBlinker TimeSensor {
	cycleInterval 1.5
	loop TRUE
}
DEF textTransparency ScalarInterpolator {
	key [ 0, 0.5, 1 ]
	keyValue [ 1, 0, 1]
}

DEF introAnim Script {
	eventIn SFTime soundLoad
	eventIn SFBool moveEnd
	eventIn SFFloat stopText
	field SFInt32 number 0
	eventOut SFTime start
	eventOut SFBool bindView
	eventOut SFTime soundNow
	eventOut SFBool bindRoom
	eventOut SFInt32 text
	eventOut SFBool textBlink
	url "javascript:
	function soundLoad(t,time){
	number = (number + 1);
	if (number == 3){
	bindView = TRUE;
	start = (time + 5);
	soundNow = (time + 25);
	}
	}
	function moveEnd(status,ts){
	if (status == FALSE){
	bindRoom = TRUE;
	}
	}
	function stopText(now) {
	text = -1;
	textBlink = FALSE;
	}
	"
}
ROUTE introTimer.fraction_changed TO introAnim.stopText
ROUTE introAnim.text TO textSwitch.whichChoice
ROUTE introAnim.textBlink TO textBlinker.set_enabled

ROUTE sound1.duration_changed TO introAnim.soundLoad
ROUTE sound2.duration_changed TO introAnim.soundLoad
ROUTE sound3Sound.duration_changed TO introAnim.soundLoad
ROUTE introAnim.start TO introTimer.startTime
ROUTE introAnim.bindView TO view.set_bind
ROUTE introTimer.fraction_changed TO introMove.set_fraction
ROUTE introTimer.fraction_changed TO introOri.set_fraction
ROUTE introMove.value_changed TO view.position
ROUTE introOri.value_changed TO view.orientation
ROUTE introAnim.soundNow TO sound1Timer.startTime
ROUTE introAnim.soundNow TO sound2Timer.startTime
ROUTE introAnim.soundNow TO sound3Timer.startTime
ROUTE introTimer.isActive TO introAnim.moveEnd
ROUTE introAnim.bindRoom TO roomView.set_bind
#ROUTE introAnim.bindRoom TO avatar1.set_bind

DEF bowAudioScript Script {
	eventIn SFTime sound1Start
	eventIn SFTime sound2Start
	eventIn SFTime sound3Start
	eventIn SFBool soundsEnable
	eventOut SFTime sound1Play
	eventOut SFTime sound2Play
	eventOut SFTime sound3Play
	eventOut SFTime sound3Stop
	eventIn SFTime stopSounds
	eventOut SFTime stop
	eventOut SFBool sloop
	url "javascript:
	function sound1Start(now1, time){
	sound1Play = time;
	
	}
	function sound2Start(now2, time){
	sound2Play = time + 5;
	}
	function sound3Start(now3, time){
	sound3Play = (time + 20);
	sound3Stop = (time + 32);
	}
	function soundsEnable (inRoom, time){
	if (inRoom == FALSE){
	stop = time;
	sloop = FALSE;
	}
	}
	"
}
ROUTE sound1Timer.cycleTime TO bowAudioScript.sound1Start
ROUTE sound2Timer.cycleTime TO bowAudioScript.sound2Start
ROUTE sound3Timer.cycleTime TO bowAudioScript.sound3Start
ROUTE bowAudioScript.sound1Play TO sound1.startTime
ROUTE bowAudioScript.sound2Play TO sound2.startTime
ROUTE bowAudioScript.sound3Play TO sound3Sound.startTime
ROUTE bowAudioScript.sound3Stop TO sound3Sound.stopTime
ROUTE	bowAudioScript.sound3Play TO sound3IntensityTimer.startTime
ROUTE sound3IntensityTimer.fraction_changed TO sound3Intensity.set_fraction
ROUTE sound3Intensity.value_changed TO sound3.intensity

ROUTE roomProx.isActive TO bowAudioScript.soundsEnable
ROUTE bowAudioScript.stop TO sound3IntensityTimer.stopTime
ROUTE bowAudioScript.stop TO sound1Timer.stopTime
ROUTE bowAudioScript.stop TO sound2Timer.stopTime
ROUTE bowAudioScript.stop TO sound3Timer.stopTime
ROUTE bowAudioScript.stop TO sound1.stopTime
ROUTE bowAudioScript.stop TO sound2.stopTime
ROUTE bowAudioScript.stop TO sound3Sound.stopTime
ROUTE bowAudioScript.sloop TO sound3Sound.loop

ROUTE textBlinker.fraction_changed TO textTransparency.set_fraction
ROUTE textTransparency.value_changed TO loadText.set_transparency

