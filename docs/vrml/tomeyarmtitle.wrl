#VRML V2.0 utf8
Collision{ 
	collide FALSE
	children [
		Transform {
			children [
				Shape {
					appearance Appearance {texture ImageTexture {url "../image/rm2yarmtitle01.gif"}}
					geometry IndexedFaceSet { 
						coord Coordinate {point [-0.533 .412 0,-0.533 -.412 0,0.533 -.412 0,0.533 .412 0]}
						coordIndex [0, 1, 2, 3, -1]
						texCoord TextureCoordinate {point [	0 1, 0 0, 1 0, 1 1]}
						texCoordIndex [0, 1, 2, 3, -1]
					}
				}
			]
		}
	]
}


