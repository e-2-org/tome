}

DEF doorOneClock TimeSensor {
	cycleInterval 10.0
	loop          FALSE
}
DEF doorOneOpen OrientationInterpolator {
	key [ 0, 0.2, 0.8 , 1 ]
	keyValue [ 0 1 0 0, 0 1 0 -2, 0 1 0 -2, 0 1 0 0]
}

DEF doorTwoClock TimeSensor {
	cycleInterval 10.0
	loop          FALSE
}
DEF doorTwoOpen OrientationInterpolator {
	key [ 0, 0.2, 0.8 , 1 ]
	keyValue [ 0 1 0 0, 0 1 0 -2, 0 1 0 -2, 0 1 0 0]
}

DEF doorSync Script {
	eventIn SFBool	doorAnimStop
	eventIn SFTime firstDoorClicked
	eventOut SFTime secondDoorOpen
	eventIn	SFTime	secondDoorClicked
	eventOut SFTime firstDoorOpen
	eventOut	SFBool	sensorEnabled
	url "javascript:
	function firstDoorClicked (ts){
	secondDoorOpen = ( ts + 7.5 );
	sensorEnabled = FALSE;
	}
	function secondDoorClicked (ts){
	firstDoorOpen = ( ts + 7.5 );
	sensorEnabled = FALSE;
	}
	function doorAnimStop (active){
	if (active == FALSE){
	sensorEnabled = TRUE;
	}
	}
	"
}
ROUTE doorSync.sensorEnabled TO doorOneTouch.enabled
ROUTE doorSync.sensorEnabled TO doorTwoTouch.enabled

ROUTE doorOneTouch.touchTime TO doorSync.firstDoorClicked
ROUTE doorTwoTouch.touchTime TO doorSync.secondDoorClicked
ROUTE doorSync.secondDoorOpen TO doorTwoClock.startTime
ROUTE doorSync.firstDoorOpen TO doorOneClock.startTime

ROUTE doorOneTouch.touchTime TO doorOneClock.startTime
ROUTE doorOneClock.fraction_changed TO doorOneOpen.set_fraction
ROUTE doorOneOpen.value_changed TO Door.set_rotation

ROUTE doorTwoTouch.touchTime TO doorTwoClock.startTime
ROUTE doorTwoClock.fraction_changed TO doorTwoOpen.set_fraction
ROUTE doorTwoOpen.value_changed TO doorTwo.set_rotation

ROUTE	doorOneClock.isActive TO doorSync.doorAnimStop
ROUTE	doorTwoClock.isActive TO doorSync.doorAnimStop

DEF aniTimer TimeSensor	{
	cycleInterval 15
	loop FALSE
} 
DEF posMover PositionInterpolator {
	key [ 0, 0.18, 0.7, 1 ]
	keyValue [0 0 0, -3.5 3 0, 3.5 1.5 0,  0 0 0]
}
DEF oriMover OrientationInterpolator {
	key [ 0, 0.25, 0.7, 0.9, 1 ]
	keyValue [0 1 0 0, 0 1 0 1.57, 0 1 0 1.57 0 1 0 3.14 , 0 1 0 -0.5]
}
DEF fieldMover ScalarInterpolator {
	key [ 0, 1 ]
	keyValue [ 1.0, 1.4]
}
DEF changeTimer TimeSensor {
	cycleInterval 6
	loop FALSE
	}
DEF aniView Script {
	directOutput  TRUE
	field 		SFNode posMover USE posMover
	field 		SFNode oriMover USE oriMover
	field 		SFNode stopView USE stopView
	field 		SFNode moveView USE moveView
	field 		SFNode avatar USE avatar
	field 		SFNode navActivationSwitch USE navActivationSwitch
	field 		SFNode navSwitch USE navSwitch
	field 		SFNode roomOneSwitch USE roomOneSwitch
	field 		SFNode roomTwoSwitch USE roomTwoSwitch
	field 		SFNode textSwitch USE textSwitch
	field 		SFNode corridorSwitch USE corridorSwitch
	field 		SFNode chairSwitch USE chairSwitch
	
	field			SFInt32			roomNum	8
	
	eventIn 	SFVec3f 		userPos
	eventIn 	SFRotation 	userOri
	eventIn 	SFFloat 		switches
	eventIn		SFTime			doorOneClick
	eventIn		SFTime			doorTwoClick
	eventIn 	SFTime 			clicked 
	eventIn 	SFBool 			aniStopped
	eventIn		SFFloat			changeSwitch
	
	field 		SFBool 			roomOne 	TRUE
	field 		SFBool 			roomTwo 	FALSE
	
	field			MFVec3f			rmZeroPosKeyVal [ 0 0 0, -4 .446608 -6, -4.55 3.3 -7.94, -2.2014 3.21754 -600 ]
	field			MFRotation	rmZeroOriKeyVal [ 0 1 0 0, 1 0 0 1, 0 1 0 3, 0 1 0 3.5 , 0 1 0 3.5]		
	field			MFFloat			rmZeroFieldKeyVal	[ 1.4, 1.4 ]
	
	field			MFVec3f			rmOnePosKeyVal [ 0 0 0, 4 0.79 0, -3 0.44 0, -6.66491 0.446608 -6.51253 ]
	field			MFRotation	rmOneOriKeyVal [ 0 1 0 0, 0 1 0 1.57, 0 1 0 1.57, 0 1 0 0.4 , 0.00524539 -0.999924 0.0111797 2.4176]		
	field			MFFloat			rmOneFieldKeyVal	[ 1.32317, 1.4 ]
	
	field			MFVec3f			rmTwoPosKeyVal [ 0 0 0, -4 1.155 0, 3 0.79 0, 5 0.79 3.72777 ]
	field			MFRotation	rmTwoOriKeyVal [ 0 1 0 0, 0 1 0 -1.57, 0 1 0 -1.57, 0 1 0 -3.10 , 0 1 0 0]		
	field			MFFloat			rmTwoFieldKeyVal	[ 1.24635, 1.32317 ]
	
	field			MFVec3f			rmThreePosKeyVal [ 0 0 0, 4 1.5125 0, -3 1.155 0, -6.30673 1.155 -6.82719 ]
	field			MFRotation	rmThreeOriKeyVal [ 0 1 0 0, 0 1 0 1.57, 0 1 0 1.57, 0 1 0 0.4 , 0 1 0 1.76424]		
	field			MFFloat			rmThreeFieldKeyVal	[  1.16952, 1.24635 ]
	
	field			MFVec3f			rmFourPosKeyVal [ 0 0 0, -4 1.87 0, 3 1.5125 0, 6.65422 1.57081 6.07305 ]
	field			MFRotation	rmFourOriKeyVal [ 0 1 0 0, 0 1 0 -1.57, 0 1 0 -1.57, 0 1 0 -3.10 , -0.143885 0.987171 0.0692092 1.18813 ]		
	field			MFFloat			rmFourFieldKeyVal	[ 1.0927, 1.16952 ]
	
	field			MFVec3f			rmFivePosKeyVal [ 0 0 0, 4 2.2275 0, -3 1.87 0, -5.81037 1.9 -5.33402 ]
	field			MFRotation	rmFiveOriKeyVal [ 0 1 0 0, 0 1 0 1.57, 0 1 0 1.57, 0 1 0 0.4 , 0 -1 0 2.95393]		
	field			MFFloat			rmFiveFieldKeyVal	[ 1.01587, 1.0927 ]
	
	field			MFVec3f			rmSixPosKeyVal [ 0 0 0, -4 2.585 0, 3 2.2275 0, 4.90896 2.25 3.33681 ]
	field			MFRotation	rmSixOriKeyVal [ 0 1 0 0, 0 1 0 -1.57, 0 1 0 -1.57, 0 1 0 -3.10 , 0.000762078 -0.998973 0.0453112 3.12394 ]		
	field			MFFloat			rmSixFieldKeyVal	[ 0.939049, 1.01587 ]
	
	field			MFVec3f			rmSevenPosKeyVal [ 0 0 0, 4 2.9425 0, -3 2.585 0, -4.16966 2.6 -3.24685 ]
	field			MFRotation	rmSevenOriKeyVal [ 0 1 0 0, 0 1 0 1.57, 0 1 0 1.57, 0 1 0 0.4 , 0 1 0 0.213535]		
	field			MFFloat			rmSevenFieldKeyVal	[ 0.862223, 0.939049 ]
	
	field			MFVec3f			rmEightPosKeyVal [ 0 0 0, -4 3.3 0, 3 2.9425 0, 6.56092 2.94971 3.26771 ]
	field			MFRotation	rmEightOriKeyVal [ 0 1 0 0, 0 1 0 -1.57, 0 1 0 -1.57, 0 1 0 -3.10 , 0.00103035 0.999043 0.0437305 2.90927 ]		
	field			MFFloat			rmEightFieldKeyVal	[  0.785398, 0.862223 ]
	
	field 		SFVec3f 		userPosition 0 0 0
	field 		SFRotation 	userOrientation 0 1 0 0
	field			SFFloat			fieldValue 1.0
	field			MFVec3f			posKeyValue [ 0 0 0, -4 3 0, -2 3 0, 4 0.75 0 ]
	field			MFRotation	oriKeyValue [0 1 0 0, 0 1 0 -1.57, 0 1 0 -1.57, 0 1 0 3.14 , 0 1 0 0]
	field			MFFloat			fieldKeyValue	[ 1, 1 ]
	field			MFString		fly		"FLY"
	
	eventOut 		SFVec3f 		stopUserPos 
	eventOut 		SFRotation 	stopUserOri 
	eventOut 		SFFloat			stopUserField
	
	eventOut	MFVec3f			posKeyValueOut
	eventOut	MFRotation	oriKeyValueOut
	eventOut	MFFloat			fieldKeyValueOut
	
	eventOut 	SFTime 			aniStart
	field    	SFInt32			roomSwitchVal  8
	eventOut  SFInt32			roomSwitchValOut
	
	eventOut 	SFTime 			changeTimerStart
	eventOut  SFInt32			textCacheSwitch
	eventOut  SFInt32			textSwitchOut
	eventOut  SFInt32			chairSwitchOut
	
	url "javascript:
	function userPos (uP){
	userPosition = uP;
	}
	function userOri (uR){
	userOrientation = uR;
	}
	
	function aniStopped (now){
	if (now == FALSE){
	avatar.avatarSize[1] = 0.44 + (0.3571 * (roomNum - 1));
	stopView.set_bind = TRUE;
	roomSwitchVal = ( roomSwitchVal - 1 );
	roomSwitchValOut = roomSwitchVal;
	textCacheSwitch = roomSwitchVal;
	if ( roomNum > 0 ) {
	roomNum = ( roomNum - 1 );
	}
	else {
	roomOneSwitch.whichChoice = -1;
	roomTwoSwitch.whichChoice = -1;
	navSwitch.whichChoice = -1;
	}
	avatar.speed = 1.0;
	navActivationSwitch.whichChoice = 0;
	corridorSwitch.whichChoice = -1;
	}
	}
	
	function aniStartNow (ts){
	posKeyValueOut = posKeyValue;
	oriKeyValueOut = oriKeyValue;
	fieldKeyValueOut = fieldKeyValue;
	aniStart = ts;
	changeTimerStart = ts;
	}
	
	function changeSwitch (frac, time){
	if (roomNum > 0){
	if (frac > 0.9){
	textSwitchOut = (roomSwitchVal - 1);
	chairSwitchOut = (roomSwitchVal - 1);
	}
	}
	}
	
	function clickedC (ts){
	if (roomNum == 0){
	posKeyValue = rmZeroPosKeyVal;
	oriKeyValue = rmZeroOriKeyVal;
	stopUserPos = rmZeroPosKeyVal[3];
	stopUserOri = rmZeroOriKeyVal[4];
	avatar.type = fly;
	//textSwitch.whichChoice = -1;
	//chairSwitch.whichChoice = -1;
	corridorSwitch.whichChoice = -1;
	roomTwoSwitch.whichChoice = -1;
	stopUserField = rmZeroFieldKeyVal[1];
	}
	else if (roomNum == 1){
	posKeyValue = rmOnePosKeyVal;
	oriKeyValue = rmOneOriKeyVal;
	fieldKeyValue = rmOneFieldKeyVal;
	stopUserPos = rmOnePosKeyVal[3];
	stopUserOri = rmOneOriKeyVal[4];
	stopUserField = rmOneFieldKeyVal[1];
	}
	else if (roomNum == 2){
	posKeyValue = rmTwoPosKeyVal;
	oriKeyValue = rmTwoOriKeyVal;
	fieldKeyValue = rmTwoFieldKeyVal;
	stopUserPos = rmTwoPosKeyVal[3];
	stopUserOri = rmTwoOriKeyVal[4];
	stopUserField = rmTwoFieldKeyVal[1];
	}
	else if (roomNum == 3){
	posKeyValue = rmThreePosKeyVal;
	oriKeyValue = rmThreeOriKeyVal;
	fieldKeyValue = rmThreeFieldKeyVal;
	stopUserPos = rmThreePosKeyVal[3];
	stopUserOri = rmThreeOriKeyVal[4];
	stopUserField = rmThreeFieldKeyVal[1];
	}
	else if (roomNum == 4){
	posKeyValue = rmFourPosKeyVal;
	oriKeyValue = rmFourOriKeyVal;
	fieldKeyValue = rmFourFieldKeyVal;
	stopUserPos = rmFourPosKeyVal[3];
	stopUserOri = rmFourOriKeyVal[4];
	stopUserField = rmFourFieldKeyVal[1];
	}
	else if (roomNum == 5){
	posKeyValue = rmFivePosKeyVal;
	oriKeyValue = rmFiveOriKeyVal;
	fieldKeyValue = rmFiveFieldKeyVal;
	stopUserPos = rmFivePosKeyVal[3];
	stopUserOri = rmFiveOriKeyVal[4];
	stopUserField = rmFiveFieldKeyVal[1];
	}
	else if (roomNum == 6){
	posKeyValue = rmSixPosKeyVal;
	oriKeyValue = rmSixOriKeyVal;
	fieldKeyValue = rmSixFieldKeyVal;
	stopUserPos = rmSixPosKeyVal[3];
	stopUserOri = rmSixOriKeyVal[4];
	stopUserField = rmSixFieldKeyVal[1];
	}
	else if (roomNum == 7){
	posKeyValue = rmSevenPosKeyVal;
	oriKeyValue = rmSevenOriKeyVal;
	fieldKeyValue = rmSevenFieldKeyVal;
	stopUserPos = rmSevenPosKeyVal[3];
	stopUserOri = rmSevenOriKeyVal[4];
	stopUserField = rmSevenFieldKeyVal[1];
	}
	else if (roomNum == 8){
	posKeyValue = rmEightPosKeyVal;
	oriKeyValue = rmEightOriKeyVal;
	fieldKeyValue = rmEightFieldKeyVal;
	stopUserPos = rmEightPosKeyVal[3];
	stopUserOri = rmEightOriKeyVal[4];
	stopUserField = rmEightFieldKeyVal[1];
	}
	posKeyValue[0] = userPosition;
	oriKeyValue[0] = userOrientation;
	fieldKeyValue[0] = fieldValue;
	aniStartNow (ts);
	}
	
	function clickedb (ts){
	moveView.set_bind = TRUE;
	clickedC(ts);
	}
	
	function clicked (ts){
	navActivationSwitch.whichChoice = -1;
	avatar.speed = 0;
	moveView.position = userPosition;
	moveView.orientation = userOrientation;
	fieldValue = 1.4 - (0.07682525 * (roomNum));
	moveView.fieldOfView = fieldValue;
	clickedb(ts);
	}
	
	function doorOneClick (ts) {
	corridorSwitch.whichChoice = 0;
	roomTwoSwitch.whichChoice = 0;
	roomOne = FALSE;
	roomTwo = TRUE;
	clicked (ts);
	}
	
	function doorTwoClick (ts) {
	corridorSwitch.whichChoice = 0;
	roomOneSwitch.whichChoice = 0;
	roomOne = TRUE;
	roomTwo = FALSE;
	clicked (ts);
	}
	
	function switches (value) {
	if (value >= 0.9) {
	if (roomOne == FALSE) {
	roomOneSwitch.whichChoice = -1;
	}
	else if (roomTwo == FALSE){
	roomTwoSwitch.whichChoice = -1;
	}
	}
	}
	"
}
ROUTE mainProx.position_changed TO aniView.userPos
ROUTE mainProx.orientation_changed TO aniView.userOri
ROUTE doorOneTouch.touchTime TO aniView.doorOneClick
ROUTE doorTwoTouch.touchTime TO aniView.doorTwoClick
ROUTE aniView.stopUserPos TO stopView.position
ROUTE aniView.stopUserOri TO stopView.orientation
ROUTE aniView.stopUserField TO stopView.fieldOfView
ROUTE aniView.posKeyValueOut TO posMover.keyValue
ROUTE aniView.oriKeyValueOut TO oriMover.keyValue
ROUTE aniView.fieldKeyValueOut TO fieldMover.keyValue
ROUTE aniView.aniStart TO aniTimer.startTime
ROUTE aniTimer.fraction_changed TO posMover.set_fraction
ROUTE aniTimer.fraction_changed TO oriMover.set_fraction
ROUTE aniTimer.fraction_changed TO fieldMover.set_fraction
ROUTE aniTimer.fraction_changed TO aniView.switches
ROUTE posMover.value_changed TO moveView.position
ROUTE oriMover.value_changed TO moveView.orientation
ROUTE fieldMover.value_changed TO moveView.fieldOfView

ROUTE aniTimer.isActive TO aniView.aniStopped
ROUTE aniView.roomSwitchValOut TO navSwitch.set_whichChoice

ROUTE aniView.changeTimerStart TO changeTimer.startTime
ROUTE changeTimer.fraction_changed TO aniView.changeSwitch
ROUTE aniView.textCacheSwitch TO textCacheSwitch.set_whichChoice
ROUTE aniView.textSwitchOut TO textSwitch.set_whichChoice
ROUTE aniView.chairSwitchOut TO chairSwitch.set_whichChoice

