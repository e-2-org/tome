DEF Universe Transform { 
	rotation 0 0 1 0
	scaleOrientation 0 0 1 0
	children [
		DirectionalLight {
			direction -0.9 0 1
			color 1 1 1
			on TRUE
		}
		DirectionalLight {
			direction 0.8 0 1
			color 1 1 1
			on TRUE
		}
		DirectionalLight {
			direction -0.2 1 -0.8
			color 1 1 1
			intensity 0.5
			on TRUE
		}
		PointLight {
			ambientIntensity  1  
			attenuation       1 0 0
			color             1 1 1
			intensity         1
			location          0 10 0 
			on                TRUE
			radius            100
		}
	DEF textCacheControl Transform {
		translation 1000 1000 1000
		children [
		DEF textCacheSwitch Switch {
			whichChoice 8
			choice [
			Group { children[]}
			DEF kettText Transform { children [ Inline { url ["tomeketttext01.wrl" ] }] }
			DEF yarmText Transform { children [ Inline { url ["tomeyarmtext01.wrl" ] }] }
			DEF hillText Transform { children [ Inline { url ["tomehilltext01.wrl" ] }] }
			DEF hithText Transform { children [ Inline { url ["tomehithtext01.wrl" ] }] }
			DEF tottText Transform { children [ Inline { url ["tometotttext01.wrl" ] }] }
			DEF turkText Transform { children [ Inline { url ["tometurktext01.wrl" ] }] }
			DEF elephText Transform { children [ Inline { url ["tomeelephtext01.wrl" ] }] }
			DEF shackText Transform { children [ Inline { url ["tomeshacktext01.wrl" ] }] }
			]
			}	
			]
			}
 		DEF textSwitch Switch {
			whichChoice 8
			choice [
				USE kettText
				USE yarmText
				USE hillText
				USE hithText
				USE tottText
				USE turkText
				USE elephText
				USE shackText
				Group { children [ Inline { url ["tomebowtext01.wrl" ] }] }
			]
		}
		
		Switch {
			whichChoice -1
			choice [
				DEF chair Transform {
					#translation -5 0 -3.1
